# ==========================================================================
# Telegram
# ==========================================================================
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Telegram ID администраторов (через запятую). Получают роль admin при /start.
ADMIN_TG_IDS=1089138631

# ==========================================================================
# PostgreSQL
# ==========================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=call_masking_bot
DB_USER=bot
DB_PASSWORD=change_me

# ==========================================================================
# amoCRM (OAuth 2.0)
# ==========================================================================
# Реквизиты приватной интеграции. Пока НЕ заполнены (subdomain/client_id/secret)
# бот работает в режиме-заглушке: /order отдаёт тестового клиента, без обращения
# к amoCRM. Это позволяет проверить весь флоу до получения реальных ключей.
#
# Поддомен без https:// (пример: mycompany.amocrm.ru)
AMOCRM_SUBDOMAIN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=https://example.com
# Одноразовый код авторизации (из интеграции amoCRM). Обменивается на токены при
# первом запуске и далее не используется. Если refresh-токен истёк — выдать новый
# код и применить командой /set_amo_code <code>.
AMOCRM_AUTH_CODE=

# ID кастомных полей amoCRM (узнать командой /amo_fields в боте).
# Адрес выезда хранится в кастомном поле сделки или контакта.
AMO_ADDRESS_FIELD_ID=
# Телефон обычно ищется по field_code=PHONE автоматически; можно переопределить ID.
AMO_PHONE_FIELD_ID=
# Телефон "клиента" в режиме-заглушке. Для живого теста звонка впишите свой номер
# (формат 7XXXXXXXXXX). По умолчанию синтетический 79991234567.
AMOCRM_STUB_PHONE=79991234567

# ==========================================================================
# Mango Office (VPBX API)
# ==========================================================================
# Реальные ключи заказчика — НЕ коммитить, заполнять только в локальном .env.
MANGO_API_KEY=
MANGO_API_SALT=
MANGO_API_URL=https://app.mango-office.ru/vpbx
# Корпоративный номер-маска (АОН), который видит клиент. Формат 7XXXXXXXXXX (без плюса).
# ВАЖНО: НЕ 8-800 — федеральные 8-800 Mango НЕ выпускает как исходящие (звонок не пройдёт).
# Только городской/мобильный номер, подключённый к ВАТС.
MANGO_LINE_NUMBER=79917790890
# Extension больше не задаётся глобально — он персональный, для каждого
# выездного администратора хранится в users.mango_extension (без него бот
# откажет в инициации звонка, а не позвонит на чужой добавочный).

# --- ПРОТОТИП «звонок без интернета» (временно, для живого теста) ---
# Админ звонит со своего мобильного на служебную линию, бот переводит вызов
# командой route. Mango шлёт события по ВСЕМ входящим звонкам ВАТС, поэтому
# перевод срабатывает только при совпадении всех трёх номеров сразу.
# Пока хоть один пуст — события только пишутся в лог, ничего не переводится.
# Все номера в формате 7XXXXXXXXXX (без плюса).
#
# Служебная линия — ОТДЕЛЬНЫЙ свободный номер ВАТС. НЕ ставить сюда
# MANGO_LINE_NUMBER: это номер-маска, который видят клиенты и на который они
# перезванивают — их звонки уйдут в тестовую логику вместо колл-центра.
MANGO_SERVICE_LINE=
# Единственный номер, звонок с которого будет переведён во время теста.
MANGO_TEST_CALLER=
# Куда переводим. На этапе проверки механики — свой тестовый номер.
MANGO_TEST_TARGET=

# ==========================================================================
# «Звонок-сигнал» — звонок без интернета у администратора
# ==========================================================================
# Админ звонит на служебную линию (MANGO_SERVICE_LINE выше) и кладёт трубку.
# Бот видит этот входящий в статистике Mango, находит админа по АОН и его
# одобренную заявку, после чего инициирует обычный callback — тот же, что по
# кнопке в Telegram. Соединяет именно callback, поэтому маска задаётся нами
# и настройки ВАТС трогать не нужно.
#
# ВАЖНО: данные статистики Mango отстают на 1-2 минуты (замер: 52 и 108 секунд
# после отбоя). Столько же админ ждёт обратного звонка — это ограничение Mango.
#
# Пока флаг выключен или не задан MANGO_SERVICE_LINE — воркер спит и в API
# не ходит вообще.
CALL_TRIGGER_ENABLED=false
# Интервал опроса, пока есть заявки со статусом «звонок одобрен», сек.
# Лимит Mango — 1 запрос в 2 секунды на всю ВАТС, и мы делим его с интеграцией
# amoCRM, поэтому чаще ставить не стоит.
CALL_TRIGGER_POLL_SEC=15
# Пауза, когда одобренных заявок нет (в это время API не дёргается), сек.
CALL_TRIGGER_IDLE_SEC=60
# Глубина выборки статистики, мин. С запасом на задержку Mango и сбои опроса.
CALL_TRIGGER_WINDOW_MIN=15

# ==========================================================================
# Сервер
# ==========================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WEBHOOK_BASE_URL=https://example.com

# ==========================================================================
# Прочее
# ==========================================================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Telegram ID разработчика — получает уведомление о запуске бота
CODER=
