# ==========================================================================
# Telegram
# ==========================================================================
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Telegram ID администраторов (через запятую). Получают роль admin при /start.
ADMIN_TG_IDS=123456789,987654321

# ==========================================================================
# PostgreSQL
# ==========================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=call_masking_bot
DB_USER=bot
DB_PASSWORD=change_me

# ==========================================================================
# amoCRM
# ==========================================================================
# Поддомен без https:// (пример: mycompany.amocrm.ru)
AMOCRM_SUBDOMAIN=mycompany.amocrm.ru
# Long-lived токен ЛИБО access_token, полученный по OAuth.
AMOCRM_ACCESS_TOKEN=
# Для автообновления токена по refresh_token (OAuth-интеграция). Можно оставить пустым,
# если используете только long-lived токен.
AMOCRM_REFRESH_TOKEN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=

# ID кастомных полей amoCRM (узнать командой /amo_fields в боте).
# Адрес выезда хранится в кастомном поле сделки или контакта.
AMO_ADDRESS_FIELD_ID=
# Телефон обычно ищется по field_code=PHONE автоматически; можно переопределить ID.
AMO_PHONE_FIELD_ID=

# ==========================================================================
# Mango Office
# ==========================================================================
MANGO_API_KEY=
MANGO_API_SALT=
MANGO_API_URL=https://app.mango-office.ru/vpbx
# Номер 8-800 в формате 7XXXXXXXXXX (без плюса)
MANGO_LINE_NUMBER=78001234567

# ==========================================================================
# Сервер
# ==========================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
WEBHOOK_BASE_URL=https://example.com

# ==========================================================================
# Прочее
# ==========================================================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
